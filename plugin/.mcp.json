{
  "mcpServers": {
    "component-belief": {
      "command": "uvx",
      "args": [
        "--from", "git+https://github.com/davechendatascience/Theoretically_Driven_LLM_Planning@tdlp--v0.7.5",
        "component-belief-mcp"
      ],
      "env": {
        "BELIEF_PROJECT_ROOT": "${CLAUDE_PROJECT_DIR}",
        "BELIEF_ACTOR": "agent",
        "UV_LINK_MODE": "copy"
      }
    },
    "consistency-belief": {
      "command": "uvx",
      "args": [
        "--from", "git+https://github.com/davechendatascience/Theoretically_Driven_LLM_Planning@tdlp--v0.7.5",
        "consistency-belief-mcp"
      ],
      "env": {
        "CONSISTENCY_PROJECT_ROOT": "${CLAUDE_PROJECT_DIR}",
        "CONSISTENCY_ACTOR": "agent",
        "UV_LINK_MODE": "copy"
      }
    },
    "stamp-monitor": {
      "command": "uvx",
      "args": [
        "--from", "git+https://github.com/davechendatascience/Theoretically_Driven_LLM_Planning@tdlp--v0.7.5",
        "stamp-monitor-mcp"
      ],
      "env": {
        "STAMP_MONITOR_ROOT": "${CLAUDE_PROJECT_DIR}",
        "UV_LINK_MODE": "copy"
      }
    },
    "graph-snapshot": {
      "command": "uvx",
      "args": [
        "--from", "git+https://github.com/davechendatascience/Theoretically_Driven_LLM_Planning@tdlp--v0.7.5",
        "graph-snapshot-mcp"
      ],
      "env": {
        "GRAPH_SNAPSHOT_ROOT": "${CLAUDE_PROJECT_DIR}",
        "UV_LINK_MODE": "copy"
      }
    }
  }
}
