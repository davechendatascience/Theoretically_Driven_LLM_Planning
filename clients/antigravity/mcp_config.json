{
  "mcpServers": {
    "component-belief": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/davechendatascience/Theoretically_Driven_LLM_Planning@tdlp--v0.12.0",
        "component-belief-mcp"
      ],
      "env": {
        "BELIEF_ACTOR": "agent",
        "UV_LINK_MODE": "copy",
        "TDLP_ISOLATED": "1"
      },
      "timeoutSeconds": 3600
    },
    "consistency-belief": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/davechendatascience/Theoretically_Driven_LLM_Planning@tdlp--v0.12.0",
        "consistency-belief-mcp"
      ],
      "env": {
        "CONSISTENCY_ACTOR": "agent",
        "UV_LINK_MODE": "copy",
        "TDLP_ISOLATED": "1"
      },
      "timeoutSeconds": 3600
    },
    "stamp-monitor": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/davechendatascience/Theoretically_Driven_LLM_Planning@tdlp--v0.12.0",
        "stamp-monitor-mcp"
      ],
      "env": {
        "UV_LINK_MODE": "copy",
        "TDLP_ISOLATED": "1"
      }
    },
    "graph-snapshot": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/davechendatascience/Theoretically_Driven_LLM_Planning@tdlp--v0.12.0",
        "graph-snapshot-mcp"
      ],
      "env": {
        "UV_LINK_MODE": "copy",
        "TDLP_ISOLATED": "1"
      }
    },
    "research-board": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/davechendatascience/Theoretically_Driven_LLM_Planning@tdlp--v0.12.0",
        "research-board-mcp"
      ],
      "env": {
        "UV_LINK_MODE": "copy",
        "TDLP_ISOLATED": "1"
      }
    }
  }
}
