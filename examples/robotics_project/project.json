      "target": ">= 0.8 on the frozen held-out split",
      "evaluation_protocol": "configs/eval_frozen.yaml"
    }
  ],
  "constraints": [
    {
      "id": "C-no-new-real-labels",
      "statement": "No new real-world annotation collection",
      "kind": "hard"
    },
    {
